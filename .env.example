# Required
OPENAI_API_KEY=your_openai_api_key
DB_CONNECTION_STRING=postgresql+psycopg2://sang:mypassword123@localhost:5432/chat_db

# Comma-separated allowed room IDs (only these rooms receive bot replies)
ALLOWED_ROOMS=123456789,-818631047

# Korean search (Naver Developers — https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Global search (Tavily — https://tavily.com)
TAVILY_API_KEY=

# Optional: MapleStory tool (Nexon Open API)
NEXON_API_KEY=

# Optional: Korea stock quotes via Korea Investment Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional tuning
RAG_SEARCH_K=10

# Dev playground (LangGraph dev — used by Agent Chat UI)
PLAYGROUND_ROOM_ID=999999999
PLAYGROUND_SENDER=dev_user

# Boss MVP (SQLite)
BOSS_DB_URL=sqlite:///./data/boss_bot.db
PUBLIC_BASE_URL=http://localhost:8000
WEEKLY_RESET_REMINDER_HOUR=12
WEEKLY_RESET_REMINDER_MINUTE=0
BOSS_REMINDER_OFFSET_MINUTES=30
BOSS_SCHEDULER_INTERVAL_SECONDS=60
DROP_ACTIVE_WINDOW_HOURS=6

# Required
OPENAI_API_KEY=your_openai_api_key
DB_CONNECTION_STRING=postgresql+psycopg2://sang:mypassword123@localhost:5432/chat_db

# Comma-separated allowed room IDs (only these rooms receive bot replies)
ALLOWED_ROOMS=123456789,-818631047

# Korean search (Naver Developers — https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Global search (Tavily — https://tavily.com)
TAVILY_API_KEY=

# Weather data (OpenWeather — https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Optional: MapleStory tool (Nexon Open API)
NEXON_API_KEY=

# Optional: Korea stock quotes via Korea Investment Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional tuning
RAG_SEARCH_K=10
MAX_CRAWL_URLS=3
CRAWL_TIMEOUT=10
ENABLE_JS=true
CACHE_TTL=1800
ENABLE_CRAWL4AI=true

# Dev playground (LangGraph dev — used by Agent Chat UI)
PLAYGROUND_ROOM_ID=999999999
PLAYGROUND_SENDER=dev_user

# Prompt variant overrides per room (room_id:variant,room_id:variant)
# Variants: default | formal | playful
DEFAULT_PROMPT_VARIANT=default
PROMPT_VARIANT_OVERRIDES=

# Boss MVP (SQLite)
BOSS_DB_URL=sqlite:///./data/boss_bot.db
PUBLIC_BASE_URL=http://localhost:8000
WEEKLY_RESET_REMINDER_HOUR=12
WEEKLY_RESET_REMINDER_MINUTE=0
BOSS_REMINDER_OFFSET_MINUTES=30
BOSS_SCHEDULER_INTERVAL_SECONDS=60
DROP_ACTIVE_WINDOW_HOURS=6

# Model routing (casual small talk -> light model)
ENABLE_MODEL_ROUTING=true
LIGHT_MODEL=gpt-4o-mini

# Iris bridge (redroid) — see deploy/iris/README.md
IRIS_BASE_URL=http://127.0.0.1:3000
# is_command 판정 트리거 (기존 폰 브리지 규칙과 동일하게 유지)
IRIS_BOT_TRIGGERS=!,！
# 봇 계정 자기 메시지 echo 무시
IRIS_SELF_NAMES=온반봇
# 레거시 room_id 연속성: "카톡chat_id:기존room_id,..." (신규 방은 자동 identity 매핑)
IRIS_ROOM_MAP=
# bot_outbox를 폰 폴링 대신 서버가 직접 Iris로 발송
ENABLE_IRIS_SENDER=false
IRIS_SENDER_INTERVAL_SECONDS=5

# Image generation model (OpenAI images API)
IMAGE_GEN_MODEL=gpt-image-1

# Health monitor + out-of-band alerts (email). See app/services/health_monitor.py
ENABLE_HEALTH_MONITOR=true
HEALTH_SELF_CHAT_ID=          # bot self-chat chat_id for send round-trip heartbeat
HEALTH_HEARTBEAT_MINUTES=360
HEALTH_IRIS_FAIL_THRESHOLD=3
HEALTH_KAKAO_FAIL_THRESHOLD=2
# SMTP (Gmail: smtp.gmail.com:587 + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Daily OpenAI spend report (needs Admin key; hour is KST 0-23)
OPENAI_ADMIN_KEY=
COST_REPORT_HOUR=9

# Cost tracking + rate limits (priority 2)
IMAGE_GEN_DAILY_LIMIT=15        # per-sender per-day image generations
CHAT_PER_MIN_LIMIT=8            # per-room per-minute LLM replies (0=off)
CHAT_LOG_RETENTION_DAYS=0       # 0=keep forever; >0 purges older FTS rows
ADMIN_ROOM_ID=0                 # optional room for in-chat admin alerts

# Optional endpoint auth (opt-in: empty = disabled). When set, /iris, /bot/outbox,
# /rooms, /debug require X-Bot-Token header or ?token=. Update Iris endpoint to
# http://<backend>:8000/iris?token=<value> if you enable this.
BOT_SHARED_TOKEN=

# Grounded web search (OpenAI Responses web_search tool) — recency + citations
ENABLE_GROUNDED_SEARCH=true
WEB_SEARCH_MODEL=gpt-4o

# Reference-based image gen (uses attached image; needs image-input model)
IMAGE_GEN_REF_MODEL=gpt-image-1

# Image providers. Plain text→image: pollinations (free, no key) | openai.
# Reference/edit: openai (gpt-image-1) | gemini (2.5 Flash Image — NOTE: free tier
# is limit=0, needs billing enabled, then ~$0.039/img). Each falls back to the
# OpenAI model above if the provider fails.
IMAGE_GEN_PROVIDER=pollinations
IMAGE_REF_PROVIDER=openai
GEMINI_API_KEY=            # Google AI Studio key; required when IMAGE_REF_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Required
OPENAI_API_KEY=your_openai_api_key
DB_CONNECTION_STRING=postgresql+psycopg2://sang:mypassword123@localhost:5432/chat_db

# Comma-separated allowed room IDs (only these rooms receive bot replies)
ALLOWED_ROOMS=123456789,-818631047

# Korean search (Naver Developers — https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Global search (Tavily — https://tavily.com)
TAVILY_API_KEY=

# Weather data (OpenWeather — https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Optional: MapleStory tool (Nexon Open API)
NEXON_API_KEY=

# Optional: Korea stock quotes via Korea Investment Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional tuning
RAG_SEARCH_K=10
MAX_CRAWL_URLS=3
CRAWL_TIMEOUT=10
ENABLE_JS=true
CACHE_TTL=1800
ENABLE_CRAWL4AI=true

# Dev playground (LangGraph dev — used by Agent Chat UI)
PLAYGROUND_ROOM_ID=999999999
PLAYGROUND_SENDER=dev_user

# Prompt variant overrides per room (room_id:variant,room_id:variant)
# Variants: default | formal | playful
DEFAULT_PROMPT_VARIANT=default
PROMPT_VARIANT_OVERRIDES=

# Boss MVP (SQLite)
BOSS_DB_URL=sqlite:///./data/boss_bot.db
PUBLIC_BASE_URL=http://localhost:8000
WEEKLY_RESET_REMINDER_HOUR=12
WEEKLY_RESET_REMINDER_MINUTE=0
BOSS_REMINDER_OFFSET_MINUTES=30
BOSS_SCHEDULER_INTERVAL_SECONDS=60
DROP_ACTIVE_WINDOW_HOURS=6

# Model routing (casual small talk -> light model)
ENABLE_MODEL_ROUTING=true
LIGHT_MODEL=gpt-4o-mini

# Iris bridge (redroid) — see deploy/iris/README.md
IRIS_BASE_URL=http://127.0.0.1:3000
# is_command 판정 트리거 (기존 폰 브리지 규칙과 동일하게 유지)
IRIS_BOT_TRIGGERS=!,！,온반봇
# 봇 계정 자기 메시지 echo 무시
IRIS_SELF_NAMES=온반봇
# 레거시 room_id 연속성: "카톡chat_id:기존room_id,..." (신규 방은 자동 identity 매핑)
IRIS_ROOM_MAP=
# bot_outbox를 폰 폴링 대신 서버가 직접 Iris로 발송
ENABLE_IRIS_SENDER=false
IRIS_SENDER_INTERVAL_SECONDS=5
